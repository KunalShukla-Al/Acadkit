{
  "name": "acadkit",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "tokens": "node scripts/gen-tokens.mjs",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "sync:files": "node --env-file-if-exists=.env.local scripts/sync-study-folder.mjs",
    "semester:switch": "node --env-file-if-exists=.env.local scripts/semester-switch.mjs",
    "sync:deletions": "node --env-file-if-exists=.env.local scripts/apply-study-deletions.mjs",
    "sync:app": "node --env-file-if-exists=.env.local scripts/apply-app-requests.mjs",
    "night:shift": "node --env-file-if-exists=.env.local scripts/night-shift.mjs",
    "send:phone": "node --env-file-if-exists=.env.local scripts/mac/send-to-phone.mjs",
    "autopilot:record": "node scripts/autopilot-record.mjs",
    "autopilot:eval": "node scripts/autopilot-eval.mjs",
    "mac:install": "bash scripts/mac/install.sh",
    "db:start": "bash scripts/local-db.sh start",
    "db:test": "bash scripts/local-db.sh test",
    "db:reset": "bash scripts/local-db.sh reset",
    "db:types": "bash scripts/local-db.sh types",
    "db:stop": "bash scripts/local-db.sh stop",
    "errors": "node --env-file-if-exists=.env.local scripts/error-report.mjs",
    "stats": "node --env-file-if-exists=.env.local scripts/usage-stats.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:iphone": "playwright test -c playwright.iphone.config.ts",
    "test:mac": "playwright test -c playwright.mac.config.ts",
    "test:recorder": "RECORDER_LIVE=1 vitest run scripts/lib/recorder.sample.test.ts",
    "recorder:eval": "node scripts/recorder-eval.mjs",
    "connected": "node scripts/connected.mjs",
    "connected:judge": "node scripts/connected-judge.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "shortcuts:check": "node scripts/check-shortcuts.mjs",
    "perf:screens": "node scripts/lighthouse-screens.mjs",
    "demo:record": "node scripts/record-demo.mjs",
    "dev:mock": "node scripts/dev-mock/server.mjs"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/query-async-storage-persister": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.62.0",
    "motion": "^12.43.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "read-excel-file": "^9.3.13",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.0.9",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "description": "Attendance, marks, timetable and study companion for SRM KTR"
}
