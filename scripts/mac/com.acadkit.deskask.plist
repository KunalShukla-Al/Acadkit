<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by npm run mac:install, which fills in __HOME__ and __REPO__. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.acadkit.deskask</string>
    <!-- bash stays the parent: it holds Full Disk Access for the study folders, and node and claude inherit it. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd "__REPO__" &amp;&amp; node --env-file-if-exists=.env.local scripts/desk-ask.mjs; exit $?</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict><key>PATH</key><string>/opt/homebrew/opt/node@24/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>30</integer>
    <key>StandardOutPath</key><string>__HOME__/Library/Logs/AcadKit/desk-ask.log</string>
    <key>StandardErrorPath</key><string>__HOME__/Library/Logs/AcadKit/desk-ask.log</string>
    <key>ProcessType</key><string>Background</string>
</dict>
</plist>
