{
  "$doc": "Each theme's colours and shapes, light and dark. Colours are HSL triplets (\"0 0% 97%\"), as the stylesheet's hsl(var(--x)) reads them; {name} refers to another token. npm run tokens writes src/design/tokens.css from this.",
  "themes": {
    "brutalist": {
      "$about": "Colour-blocked, oversized, loud: lime on near-black or near-white, a coral second accent, big squircles with a real border and no shadow. Titles and numbers are set in Chakra Petch (src/index.css).",
      "light": {
        "bg": "0 0% 97%",
        "surface": "0 0% 100%",
        "surface-2": "0 0% 93%",
        "line": "0 0% 0%",
        "ink": "0 0% 6%",
        "muted": "0 0% 42%",
        "accent": "72 89% 56%",
        "accent-2": "6 78% 60%",
        "good-deep": "142 64% 27%",
        "warn-deep": "35 85% 30%",
        "bad-deep": "6 78% 44%",
        "accent-deep": "72 70% 26%",
        "shadow-card": "0 0 0 0 rgb(0 0 0 / 0)",
        "line-alpha": "0.1",
        "radius-card": "1.75rem",
        "brand": "{accent}",
        "brand-ink": "0 0% 6%"
      },
      "dark": {
        "bg": "0 0% 4%",
        "surface": "0 0% 8%",
        "surface-2": "0 0% 14%",
        "line": "0 0% 100%",
        "ink": "0 0% 98%",
        "muted": "0 0% 60%",
        "accent": "72 89% 60%",
        "accent-2": "6 78% 62%",
        "good-deep": "142 70% 58%",
        "warn-deep": "45 90% 62%",
        "bad-deep": "6 82% 64%",
        "accent-deep": "72 89% 60%",
        "shadow-card": "0 0 0 0 rgb(0 0 0 / 0)",
        "line-alpha": "0.14",
        "radius-card": "1.75rem",
        "brand": "{accent}",
        "brand-ink": "0 0% 6%"
      }
    },
    "oled": {
      "$about": "True black and zero saturation: in dark mode --bg is literal #000, pixels off on an OLED panel, and the mark inverts rather than colouring.",
      "light": {
        "bg": "0 0% 100%",
        "surface": "0 0% 100%",
        "surface-2": "0 0% 93%",
        "line": "0 0% 0%",
        "ink": "0 0% 9%",
        "muted": "0 0% 40%",
        "accent": "0 0% 20%",
        "accent-2": "0 0% 42%",
        "good-deep": "142 60% 30%",
        "warn-deep": "35 85% 30%",
        "bad-deep": "350 72% 42%",
        "accent-deep": "0 0% 20%",
        "shadow-card": "0 1px 2px rgb(0 0 0 / 0.06), 0 10px 26px -14px rgb(0 0 0 / 0.16)",
        "line-alpha": "0.12",
        "radius-card": "0.875rem",
        "brand": "0 0% 9%",
        "brand-ink": "0 0% 100%"
      },
      "dark": {
        "bg": "0 0% 0%",
        "surface": "0 0% 4%",
        "surface-2": "0 0% 10%",
        "line": "0 0% 100%",
        "ink": "0 0% 96%",
        "muted": "0 0% 58%",
        "accent": "0 0% 38%",
        "accent-2": "0 0% 58%",
        "good-deep": "142 70% 55%",
        "accent-deep": "0 0% 80%",
        "warn-deep": "45 90% 60%",
        "bad-deep": "350 85% 65%",
        "shadow-card": "0 1px 0 rgb(255 255 255 / 0.03) inset, 0 14px 34px -16px rgb(0 0 0 / 0.9)",
        "line-alpha": "0.16",
        "radius-card": "0.875rem",
        "brand": "0 0% 96%",
        "brand-ink": "0 0% 4%"
      }
    }
  }
}
